{
  "name": "siddis-wars-piffi-pulver",
  "version": "0.10.0-alpha",
  "private": true,
  "description": "Vestkyst: Stavanger strategy game and reproducible QA harness",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test qa/*.test.cjs",
    "qa:strategy": "node test-strategy.cjs",
    "qa:balance": "node qa/simulate.cjs --seeds 30",
    "qa:fixtures": "node qa/fixtures.cjs",
    "start": "node qa/serve.cjs",
    "qa:meta": "node qa/meta.cjs",
    "qa:exchange": "node qa/exchange-stress.cjs",
    "qa:experience": "node qa/experience-sim.cjs --seeds 3",
    "qa:coast": "node qa/experience-sim.cjs --seeds 3 --coast --output coast-campaigns.json",
    "qa:early": "node qa/early-progress.cjs --seeds 30"
  }
}
