{
  "schema": 1,
  "financialDefinitions": {
    "legacyGiven": "s.legacyFund.paid: irreversible contributions to the chosen legacy recipients. Reported separately from productive reinvestment; never added into a combined reinvestment score.",
    "productiveReinvestment": "s.scale.invested: cumulative recorded infrastructure, territory, route-capacity and factory investment. This engine counter is not a claim to include every capital purchase.",
    "postGodfatherProductiveReinvestment": "s.scale.postInvested: the same recorded productive investment after reaching Godfather.",
    "cashNetWorthRatio": "cash / cashNetWorthDenominator, where cashNetWorthDenominator is the reported netWorth in kroner. Null when netWorth is nonpositive; ratios may exceed 1 when liabilities reduce net worth. Summary median is the median of defined per-run ratios, not a ratio of medians.",
    "cashImperialValueRatio": "cash / cashImperialValueDenominator, where cashImperialValueDenominator is G.empireScore(s).value (also reported as imperialValue), the engine productive imperial valuation in kroner. This is distinct from net worth. Null when imperial value is nonpositive; summary medians use defined per-run ratios, not a ratio of medians.",
    "reinvestmentShare": "Existing s.scale.postInvested / s.scale.postOperating counter ratio, retained unchanged. legacyGiven is a separate use of cash and is not included in the numerator."
  },
