{
  "schema": 1,
  "financialDefinitions": {
    "legacyGiven": "s.legacyFund.paid: irreversible contributions to the chosen legacy recipients. Reported separately from productive reinvestment; never added into a combined reinvestment score.",
    "productiveReinvestment": "s.scale.invested: cumulative recorded infrastructure, territory, route-capacity, factory and ownership-stage investment. This engine counter is not a claim to include every capital purchase.",
    "postGodfatherProductiveReinvestment": "s.scale.postInvested: the same recorded productive investment after reaching Godfather.",
    "cashNetWorthRatio": "cash / cashNetWorthDenominator, where cashNetWorthDenominator is the reported netWorth in kroner. Null when netWorth is nonpositive; ratios may exceed 1 when liabilities reduce net worth. Summary median is the median of defined per-run ratios, not a ratio of medians.",
    "cashImperialValueRatio": "cash / cashImperialValueDenominator, where cashImperialValueDenominator is G.empireScore(s).value (also reported as imperialValue), the engine productive imperial valuation in kroner. This is distinct from net worth. Null when imperial value is nonpositive; summary medians use defined per-run ratios, not a ratio of medians.",
    "ownershipInvested": "s.ownership.invested: actual funded productive acquisition/expansion capital, already included once in scale.invested; not added to it again. Completed firms/stages are reported separately from active construction.",
    "ownershipNegotiationExpenseRecorded": "Costs of buyout counteroffer responses in retained firm history (at most18rows per firm). Operating negotiation expense, never productive investment; this is retained-record evidence, not a guaranteed lifetime expense counter.",
    "reinvestmentShare": "Existing s.scale.postInvested / s.scale.postOperating counter ratio, retained unchanged. legacyGiven is a separate use of cash and is not included in the numerator."
  },
  "progressionDefinitions": {
    "firstRankActions": "Completed outer public player actions up to and including the first observed rank >= 1. Nested automatic engine actions and UI navigation are excluded. Injected story decisions in the integrated simulator count separately and also count toward its total.",
    "firstRankDay": "Actual game day on the first completed public action observed at rank >= 1; null if never reached.",
    "firstRankClicks": "Not measured by engine simulations. Always null; actions are not a browser click count.",
    "itemPaths": "Owned item attribution uses actual recorded quest choices mapped to their reward definition. help = help choice, dark = exploit choice; other, unknown or ambiguous evidence remains explicit. No history is invented for imported items."
  },
  "ownershipPolicy": {
    "enabled": true,
    "scope": "New post-Godfather policy extension only: the original business decisions before Godfather are unchanged.",
    "mandates": {
      "careful": "partners",
      "expansion": "control",
      "aggressive": "control"
    },
    "control": "With disableOwnership:true the agent does not adopt an ownership mandate; the same current engine and all other profile decisions remain in use. This is a paired policy control, not the historical alpha0.9 engine."
  },
